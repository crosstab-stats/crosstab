# Dependencies (none yet — everything is native ES modules + CDN)
node_modules/

# Editor / OS cruft
.DS_Store
Thumbs.db
*.log
.vscode/
.idea/
# Claude Code local config (preview dev-server launch.json, local settings) — machine-specific
.claude/

# Vendored binaries / icons placeholder (add real assets, ignore scratch)
vendor/*.wasm

# What `scripts/vendor-assets.mjs` downloads for an air-gapped build. These are other
# people's release artefacts fetched on demand (hundreds of MB with the Whisper weights),
# and docs/OFFLINE.md says to run the script per machine and copy the directory -- so they
# are deliberately not history. Only `vendor/*.wasm` was listed before, which left every
# other vendored directory showing up as untracked and one `git add -A` away from being
# committed. The tracked contents of vendor/ (the icons, readstat) are not affected.
vendor/webr/
vendor/webr-packages/
vendor/duckdb/
vendor/arrow/
vendor/hyparquet-writer/
vendor/trystero/
vendor/transformers/
vendor/onnxruntime/
vendor/whisper/

# A deployment's own settings (#185). The committed template is deploy.example.json; the live
# file is yours, so it is never in our history and never conflicts on `git pull`.
deploy.json

# A deployment's own plugin directory (#185) — whatever it points pluginDir at is theirs.
site-plugins/

# Local build output (if a bundler is added later)
dist/

# Real-world sample data for local import testing (drop GSS .sav/.dta/.sas here).
# Served at /sample-data/ so tests can fetch it; never committed.
sample-data/

# The rendered checklist page — `node scripts/build-test-page.mjs` output. The markdown
# in docs/TESTING.md is the source of truth; this is a local working copy whose progress
# lives in your own localStorage.
testing.html
